# AI Investment Analyst — Environment Variables
# Copy to .env and fill in values

# =============================================================================
# REQUIRED
# =============================================================================

# Groq API key for LLM inference (router + analysis models)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# MongoDB connection string
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=investment_analyst

# NewsAPI key for financial news
# Get one at: https://newsapi.org/register
NEWS_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# Alpha Vantage API key (premium market data, fallback only)
# Get one at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Demo auth password (set in production to gate access)
# Leave empty to disable auth gate in development
DEMO_PASSWORD=

# Scheduler secret token (protects cache warming endpoint)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET_TOKEN=

# Frontend URL for CORS (production only)
# Example: https://ai-investment-analyst.vercel.app
FRONTEND_URL=http://localhost:5173

# Server port (Railway sets this automatically)
PORT=8000
