# AI Investment Analyst: Environment Variables
# Copy to .env and fill in values

# =============================================================================
# REQUIRED
# =============================================================================

# Groq API key for LLM inference (router + analysis models)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL connection string
# Local: postgresql://invest:invest_dev@localhost:5432/investment_analyst
# Production: Neon serverless PostgreSQL (pooled connection)
# Get one at: https://neon.tech (use the pooled connection string)
DATABASE_URL=postgresql://invest:invest_dev@localhost:5432/investment_analyst

# NewsAPI key for financial news
# Get one at: https://newsapi.org/register
NEWS_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# Alpha Vantage API key (premium market data, fallback only)
# Get one at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Authentication: session login protects API routes by default.
# Use AUTH_MODE=demo to ALSO accept DEMO_PASSWORD; disabled is development-only.
ENVIRONMENT=development
AUTH_MODE=session
ADMIN_USERNAME=admin
# Published default is for local development only; production rejects it.
ADMIN_PASSWORD=investor2026
# Production requires a separate random secret of at least 32 characters,
# shared across workers/machines. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty in development uses a process-local key; restarting invalidates sessions.
SESSION_SIGNING_SECRET=
DEMO_PASSWORD=

# Scheduler secret token (protects the admin and scheduled endpoints)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET_TOKEN=

# Telegram bot for Reasoning-Aware Signal Alerts
# Create a bot via @BotFather on Telegram to get a token, then register the
# webhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Frontend URL for CORS (production only)
# Example: https://ai-investment-analyst-iota.vercel.app
FRONTEND_URL=http://localhost:5173

# Server port (Fly.io uses 8000 by default)
PORT=8000
