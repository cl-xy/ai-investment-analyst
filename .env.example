# AI Investment Analyst: Environment Variables
# Copy to .env and fill in values

# =============================================================================
# REQUIRED
# =============================================================================

# Groq API key for LLM inference (router + analysis models)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL connection string
# Local: postgresql://invest:invest_dev@localhost:5432/investment_analyst
# Production: Neon serverless PostgreSQL (pooled connection)
# Get one at: https://neon.tech (use the pooled connection string)
DATABASE_URL=postgresql://invest:invest_dev@localhost:5432/investment_analyst

# NewsAPI key for financial news
# Get one at: https://newsapi.org/register
NEWS_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# Alpha Vantage API key (premium market data, fallback only)
# Get one at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Demo auth password (set in production to gate access)
# Leave empty to disable auth gate in development
DEMO_PASSWORD=

# Scheduler secret token (protects cache warming endpoint)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET_TOKEN=

# Frontend URL for CORS (production only)
# Example: https://ai-investment-analyst-iota.vercel.app
FRONTEND_URL=http://localhost:5173

# Server port (Fly.io uses 8000 by default)
PORT=8000
