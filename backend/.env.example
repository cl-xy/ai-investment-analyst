# Copy this file to .env and fill in your keys

# Required
GROQ_API_KEY=your_groq_api_key_here
NEWS_API_KEY=your_newsapi_key_here

# Optional fallback — Alpha Vantage free tier (25 calls/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Optional — override default data directory
# MCP_DATA_DIR=~/.mcp_investment

# MongoDB (for persisting analysis results)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=investment_analyst

# Scheduler integration (for nightly portfolio refresh endpoint)
# SCHEDULER_SECRET_TOKEN=replace_with_strong_shared_secret
# SCHEDULER_REFRESH_LOCK_SECONDS=900
