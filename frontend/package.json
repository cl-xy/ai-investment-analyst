{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @live-analysis",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --grep @live-analysis"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.18.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "9.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^25.0.0",
    "msw": "^2.7.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
